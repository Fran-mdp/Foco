{
  "manifest_version": 3,
  "name": "Foco · Bloqueador de estudio",
  "version": "0.4.0",
  "description": "Bloqueador local de sitios elegidos por vos. Permisos de Chrome por dominio.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Foco · Abrí la app para controlar tu sesión",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none';"
  }
}